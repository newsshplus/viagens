# ============================================
# VIAGENS SMART - Variaveis de Ambiente (Vercel)
# Configure em: Project Settings -> Environment Variables
# ============================================

# --- OBRIGATORIO (Skyscanner via RapidAPI) ---
# Cadastro gratis: https://rapidapi.com (Sky Scrapper - 100 req/mes gratis)
RAPIDAPI_KEY=

# --- OBRIGATORIO (Travelpayouts) ---
# Cadastro gratis: https://www.travelpayouts.com/
TRAVELPAYOUTS_TOKEN=

# --- OPCIONAL (analise por IA do historico de precos) ---
# Cadastro gratis: https://console.groq.com/
GROQ_API_KEY=

# Observacao: o Google Flights (@punitarani/fli) nao precisa de chave.
